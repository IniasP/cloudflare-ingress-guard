{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      "description": "JOSDK, its Spring Boot starter, fabric8 and Spring Boot are version-locked to each other; upgrade them together.",
      "matchManagers": ["maven"],
      "matchPackageNames": [
        "org.springframework.boot:**",
        "io.javaoperatorsdk:**",
        "io.fabric8:**"
      ],
      "groupName": "JOSDK / fabric8 / Spring Boot",
      "separateMajorMinor": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/docker-publish\\.yml$/"
      ],
      "matchStrings": [
        "cosign-release:\\s*'(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)'"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sigstore/cosign"
    }
  ]
}
